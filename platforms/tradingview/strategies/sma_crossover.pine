//@version=5
strategy("Futures Lab SMA Crossover (Prop Firm Ready)", shorttitle="FL_SMA_Prop", overlay=true, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, calc_on_every_tick=false)

// === Parámetros de Estrategia ===
fastPeriod = input.int(10, "SMA Rápida", minval=1, group="Estrategia")
slowPeriod = input.int(20, "SMA Lenta", minval=2, group="Estrategia")
contracts  = input.int(1, "Contratos", minval=1, group="Estrategia")

// === Reglas de Empresa de Fondeo (Prop Firm Guard) ===
enableDailyLimit = input.bool(true, "Activar Límite de Pérdida Diaria (DLL)", group="Reglas de Fondeo")
dailyLossLimitUsd = input.float(1000.0, "Pérdida Diaria Máxima (USD)", minval=50.0, group="Reglas de Fondeo")
tradingSession = input.session("0930-1555", "Ventana operativa (cierra al salir)", group="Reglas de Fondeo")

// === Indicadores ===
fastSma = ta.sma(close, fastPeriod)
slowSma = ta.sma(close, slowPeriod)

plot(fastSma, "SMA Rápida", color=color.new(#38BDF8, 0), linewidth=2)
plot(slowSma, "SMA Lenta", color=color.new(#F59E0B, 0), linewidth=2)

// === Control de Pérdida Diaria ===
var float dayStartEquity = strategy.equity
if ta.change(time("D")) != 0
    dayStartEquity := strategy.equity

currentDayPnl = strategy.equity - dayStartEquity
dailyLimitHit = enableDailyLimit and (currentDayPnl <= -dailyLossLimitUsd)
inSession = not na(time(timeframe.period, tradingSession))

// === Señales (Paridad con Core SmaCrossoverStrategy) ===
bullCross = ta.crossover(fastSma, slowSma)
bearCross = ta.crossunder(fastSma, slowSma)

if not inSession or dailyLimitHit
    if strategy.position_size != 0
        strategy.close_all(comment = dailyLimitHit ? "DLL Hit" : "Session Close")
else
    if strategy.position_size > 0 and bearCross
        strategy.close("Long", comment="Exit Long")
    else if strategy.position_size < 0 and bullCross
        strategy.close("Short", comment="Exit Short")
    else if strategy.position_size == 0
        if bullCross
            strategy.entry("Long", strategy.long, qty=contracts)
        else if bearCross
            strategy.entry("Short", strategy.short, qty=contracts)
